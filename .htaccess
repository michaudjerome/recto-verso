# Recto Verso sur l'hébergement OVH : HTTPS, adresse sans www, fichiers de travail cachés, compression, cache.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
# Modules JavaScript : sans ce type, le navigateur refuse ts-fsrs.mjs et l'app reste vide
AddType text/javascript .js .mjs

<IfModule mod_rewrite.c>
RewriteEngine On
# Toujours en HTTPS, toujours sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# Outils de construction, sources de contenu et fichiers cachés : jamais servis
RewriteRule ^(tools|content|\.git)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule \.(py|md|sh)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
# La page et le service worker sont toujours revérifiés ; le reste est versionné par empreinte
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(js|css|json)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(svg|png|woff2|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "^sw\.js$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
